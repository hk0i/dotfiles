#!/bin/bash
# generate-macos-icons — produce AppIcon.appiconset PNGs from a 1024x1024 source

set -euo pipefail

src="$1"
outDir="${2:-AppIcon.appiconset}"

if [[ -z "$src" ]]; then
    echo "Usage: $(basename "$0") <source-1024.png> [output-dir]" >&2
    exit 1
fi

mkdir -p "$outDir"

for size in 16 32 64 128 256 512; do
    sips -z "$size" "$size" "$src" --out "$outDir/icon_${size}x${size}.png" >/dev/null
done

echo "Done: $outDir"
